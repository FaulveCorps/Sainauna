<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sainauna.WritePage"
             Title="Write Baybayin"
             BackgroundColor="#F5EBDC">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="15">

        <!-- Header with Stats -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*" Margin="0,5,0,10">
            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                <Label Text="SPEED" FontSize="10" TextColor="#8B7355" HorizontalOptions="Center"/>
                <Label x:Name="SpeedLabel" Text="0 pts" FontSize="14" FontAttributes="Bold" TextColor="#654321" HorizontalOptions="Center"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                <Label Text="ACCURACY" FontSize="10" TextColor="#8B7355" HorizontalOptions="Center"/>
                <Label x:Name="AccuracyLabel" Text="0%" FontSize="14" FontAttributes="Bold" TextColor="#654321" HorizontalOptions="Center"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                <Label Text="TOTAL" FontSize="10" TextColor="#8B7355" HorizontalOptions="Center"/>
                <Label x:Name="TotalPointsLabel" Text="0" FontSize="14" FontAttributes="Bold" TextColor="#654321" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Timer and Level Info -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
            <Border Grid.Column="0" BackgroundColor="#E8DCC8" Stroke="#8B5A2B" StrokeThickness="1" Padding="8,4">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Label x:Name="TimerLabel" Text="0.0s" FontSize="14" FontAttributes="Bold" TextColor="#8B5A2B"/>
            </Border>

            <Label Grid.Column="1" x:Name="LevelLabel" Text="Level 1: Guided Tracing" 
                   FontSize="12" FontAttributes="Bold" TextColor="#654321" 
                   HorizontalOptions="Center" VerticalOptions="Center"/>

            <Border Grid.Column="2" BackgroundColor="#E8DCC8" Stroke="#8B5A2B" StrokeThickness="1" Padding="8,4">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Label x:Name="ProgressLabel" Text="1/5" FontSize="14" FontAttributes="Bold" TextColor="#8B5A2B"/>
            </Border>
        </Grid>

        <!-- Drawing Canvas Area -->
        <Border Grid.Row="2" BackgroundColor="#FFF8DC" Stroke="#8B5A2B" StrokeThickness="3" 
                Padding="10" Margin="0,0,0,10"
                Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.2}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15"/>
            </Border.StrokeShape>
            <Grid>
                <!-- Guide Image (Background) -->
                <Image x:Name="GuideImage" 
                       Aspect="AspectFit" 
                       Opacity="0.3"
                       IsVisible="True"/>

                <!-- Drawing Canvas -->
                <GraphicsView x:Name="DrawingCanvas"
                             BackgroundColor="Transparent"
                             StartInteraction="OnStartInteraction"
                             DragInteraction="OnDragInteraction"
                             EndInteraction="OnEndInteraction"/>

                <!-- Target Character Display (for word mode) -->
                <FlexLayout x:Name="TargetWordLayout" 
                           Wrap="Wrap" 
                           JustifyContent="Center"
                           IsVisible="False"
                           InputTransparent="True"/>
            </Grid>
        </Border>

        <!-- Instructions -->
        <Label Grid.Row="2" x:Name="InstructionLabel" 
               Text="Trace the character with your finger" 
               FontSize="12" TextColor="#8B7355" 
               HorizontalOptions="Center" VerticalOptions="End"
               Margin="0,0,0,20"/>

        <!-- Control Buttons -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <Button Grid.Column="0" 
                    Text="🗑️ Clear" 
                    FontSize="14"
                    TextColor="#654321"
                    BackgroundColor="#D2B48C"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnClearClicked"/>

            <Button Grid.Column="1" 
                    x:Name="CheckButton"
                    Text="✓ Check" 
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#FFF8DC"
                    BackgroundColor="#6B8E23"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnCheckClicked"/>

            <Button Grid.Column="2" 
                    x:Name="NextButton"
                    Text="Next →" 
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#FFF8DC"
                    BackgroundColor="#8B5A2B"
                    CornerRadius="10"
                    HeightRequest="50"
                    IsEnabled="False"
                    Opacity="0.5"
                    Clicked="OnNextClicked"/>
        </Grid>

    </Grid>

</ContentPage>
