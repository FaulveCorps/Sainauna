<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sainauna.BaybayinPage"
             Title="Baybayin Alphabet"
             BackgroundColor="#F5EBDC">

    <Grid RowDefinitions="Auto,Auto,*" Padding="15">

        <!-- Header -->
        <Label Grid.Row="0"
               Text="Baybayin Characters"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="#654321"
               HorizontalOptions="Center"
               Margin="0,10,0,5"/>

        <Label Grid.Row="1"
               Text="Tap any character to view"
               FontSize="14"
               TextColor="#8B7355"
               HorizontalOptions="Center"
               Margin="0,0,0,15"/>

        <!-- Character Grid -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="20">

                <!-- Vowels Section -->
                <Border x:Name="VowelsBorder"
                        BackgroundColor="#E8DCC8"
                        Stroke="#8B5A2B"
                        StrokeThickness="2"
                        Padding="15"
                        Opacity="0"
                        TranslationY="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout>
                        <Label Text="Vowels"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#654321"
                               HorizontalOptions="Center"
                               Margin="0,0,0,10"/>
                        <FlexLayout x:Name="VowelsLayout"
                                   Wrap="Wrap"
                                   JustifyContent="SpaceAround"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Consonants + A Section -->
                <Border x:Name="ConsonantsABorder"
                        BackgroundColor="#E8DCC8"
                        Stroke="#8B5A2B"
                        StrokeThickness="2"
                        Padding="15"
                        Opacity="0"
                        TranslationY="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout>
                        <Label Text="Consonants + A"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#654321"
                               HorizontalOptions="Center"
                               Margin="0,0,0,10"/>
                        <FlexLayout x:Name="ConsonantsALayout"
                                   Wrap="Wrap"
                                   JustifyContent="SpaceAround"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Consonants + E/I Section -->
                <Border x:Name="ConsonantsEIBorder"
                        BackgroundColor="#E8DCC8"
                        Stroke="#8B5A2B"
                        StrokeThickness="2"
                        Padding="15"
                        Opacity="0"
                        TranslationY="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout>
                        <Label Text="Consonants + E/I (Kudlit)"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#654321"
                               HorizontalOptions="Center"
                               Margin="0,0,0,10"/>
                        <FlexLayout x:Name="ConsonantsEILayout"
                                   Wrap="Wrap"
                                   JustifyContent="SpaceAround"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Consonants + O/U Section -->
                <Border x:Name="ConsonantsOUBorder"
                        BackgroundColor="#E8DCC8"
                        Stroke="#8B5A2B"
                        StrokeThickness="2"
                        Padding="15"
                        Opacity="0"
                        TranslationY="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout>
                        <Label Text="Consonants + O/U (Kudlit)"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#654321"
                               HorizontalOptions="Center"
                               Margin="0,0,0,10"/>
                        <FlexLayout x:Name="ConsonantsOULayout"
                                   Wrap="Wrap"
                                   JustifyContent="SpaceAround"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
