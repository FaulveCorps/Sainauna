<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sainauna.MainPage"
             Title="Sainauna"
             BackgroundColor="#F5EBDC">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20">

        <!-- Header with Home and Settings -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,20">
            <ImageButton Grid.Column="0"
                         x:Name="HomeButton"
                         Source="home_icon.png"
                         WidthRequest="40"
                         HeightRequest="40"
                         BackgroundColor="Transparent"
                         Clicked="OnHomeClicked"
                         Opacity="0"/>

            <Label Grid.Column="1"
                   x:Name="TitleLabel"
                   Text="SAINAUNA"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#654321"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Opacity="0"
                   Scale="0.8"/>

            <ImageButton Grid.Column="2"
                         x:Name="SettingsButton"
                         Source="settings_icon.png"
                         WidthRequest="40"
                         HeightRequest="40"
                         BackgroundColor="Transparent"
                         Clicked="OnSettingsClicked"
                         Opacity="0"/>
        </Grid>

        <!-- Progress Tracker -->
        <Border Grid.Row="1" 
                x:Name="ProgressBorder"
                BackgroundColor="#E8DCC8"
                Stroke="#8B5A2B"
                StrokeThickness="2"
                Padding="15"
                Margin="0,0,0,20"
                Opacity="0"
                TranslationY="30">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15"/>
            </Border.StrokeShape>
            <VerticalStackLayout>
                <Label Text="Your Progress"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#654321"
                       HorizontalOptions="Center"/>
                <ProgressBar x:Name="ProgressBar"
                            Progress="0"
                            ProgressColor="#8B5A2B"
                            HeightRequest="20"
                            Margin="0,10,0,5"/>
                <Label x:Name="ProgressLabel"
                       Text="0%"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#654321"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Border>

        <!-- Main Buttons -->
        <VerticalStackLayout Grid.Row="2" Spacing="15" VerticalOptions="Center">

            <!-- Baybayin Page Button -->
            <Button x:Name="BaybayinButton"
                    Text="📜 Baybayin Alphabet"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#FFF8DC"
                    BackgroundColor="#8B5A2B"
                    CornerRadius="15"
                    HeightRequest="70"
                    Clicked="OnBaybayinClicked"
                    Opacity="0"
                    TranslationX="-50"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Radius=6, Opacity=0.3}"/>

            <!-- Learn Page Button -->
            <Button x:Name="LearnButton"
                    Text="📚 Learn Baybayin"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#FFF8DC"
                    BackgroundColor="#A0522D"
                    CornerRadius="15"
                    HeightRequest="70"
                    Clicked="OnLearnClicked"
                    Opacity="0"
                    TranslationX="50"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Radius=6, Opacity=0.3}"/>

            <!-- Test Your Baybayin Button -->
            <Button x:Name="TestButton"
                    Text="✍️ Test Your Baybayin"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#FFF8DC"
                    BackgroundColor="#6B4423"
                    CornerRadius="15"
                    HeightRequest="70"
                    Clicked="OnTestYourBaybayinClicked"
                    Opacity="0"
                    TranslationX="-50"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Radius=6, Opacity=0.3}"/>

        </VerticalStackLayout>

        <!-- Footer -->
        <Label Grid.Row="3"
               x:Name="FooterLabel"
               Text="Learn the Ancient Philippine Script"
               FontSize="14"
               FontAttributes="Italic"
               TextColor="#8B7355"
               HorizontalOptions="Center"
               Margin="0,20,0,0"
               Opacity="0"/>

        <!-- Tutorial Overlay -->
        <Grid x:Name="TutorialOverlay"
              Grid.Row="0" Grid.RowSpan="4"
              BackgroundColor="#80000000"
              IsVisible="False">
            <Border BackgroundColor="#FFF8DC"
                    Stroke="#8B5A2B"
                    StrokeThickness="2"
                    Padding="20"
                    Margin="30"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="15">
                    <Label x:Name="TutorialTitle"
                           Text="Welcome to Sainauna!"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#654321"
                           HorizontalOptions="Center"/>
                    <Label x:Name="TutorialContent"
                           Text="Learn Baybayin, the ancient Philippine writing system."
                           FontSize="14"
                           TextColor="#8B7355"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                    <Image x:Name="TutorialImage"
                           WidthRequest="100"
                           HeightRequest="100"
                           Aspect="AspectFit"/>
                    <Button x:Name="TutorialNextButton"
                            Text="Next"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#FFF8DC"
                            BackgroundColor="#8B5A2B"
                            CornerRadius="10"
                            HeightRequest="50"
                            Clicked="OnTutorialNextClicked"/>
                    <Button x:Name="TutorialSkipButton"
                            Text="Skip Tutorial"
                            FontSize="12"
                            TextColor="#8B7355"
                            BackgroundColor="Transparent"
                            Clicked="OnTutorialSkipClicked"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>