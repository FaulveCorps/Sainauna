<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sainauna.LearnPage"
             Title="Learn Baybayin"
             BackgroundColor="#F5EBDC">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Margin="0,10,0,20">
            <Label Text="Learn Baybayin"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#654321"
                   HorizontalOptions="Center"/>
            <Label Text="Choose your learning path"
                   FontSize="14"
                   TextColor="#8B7355"
                   HorizontalOptions="Center"
                   Margin="0,5,0,0"/>
        </VerticalStackLayout>

        <!-- Level Indicator -->
        <Border Grid.Row="1" 
                BackgroundColor="#E8DCC8"
                Stroke="#8B5A2B"
                StrokeThickness="2"
                Padding="10"
                Margin="0,0,0,20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <Label x:Name="WriteUnlockLabel"
                   Text="Start with Guided Tracing!"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#6B8E23"
                   HorizontalOptions="Center"/>
        </Border>

        <!-- Learning Options -->
        <VerticalStackLayout Grid.Row="2" Spacing="15" VerticalOptions="Center">

            <!-- Memorize Button -->
            <Border x:Name="MemorizeBorder"
                    BackgroundColor="#E8DCC8"
                    Stroke="#8B5A2B"
                    StrokeThickness="2"
                    Padding="20"
                    Opacity="0"
                    TranslationX="-30"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.2}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                    <Label Grid.Column="0"
                           Text="🧠"
                           FontSize="40"
                           VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Memorize"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#654321"/>
                        <Label Text="Flashcards to help you remember characters"
                               FontSize="14"
                               TextColor="#8B7355"/>
                    </VerticalStackLayout>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMemorizeClicked"/>
                </Border.GestureRecognizers>
            </Border>

            <!-- Quiz Button -->
            <Border x:Name="QuizBorder"
                    BackgroundColor="#E8DCC8"
                    Stroke="#8B5A2B"
                    StrokeThickness="2"
                    Padding="20"
                    Opacity="0"
                    TranslationX="30"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.2}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                    <Label Grid.Column="0"
                           Text="❓"
                           FontSize="40"
                           VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Quiz"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#654321"/>
                        <Label Text="Test your Baybayin knowledge"
                               FontSize="14"
                               TextColor="#8B7355"/>
                    </VerticalStackLayout>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnQuizClicked"/>
                </Border.GestureRecognizers>
            </Border>

            <!-- Test Button -->
            <Border x:Name="TestBorder"
                    BackgroundColor="#E8DCC8"
                    Stroke="#8B5A2B"
                    StrokeThickness="2"
                    Padding="20"
                    Opacity="0"
                    TranslationX="-30"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.2}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                    <Label Grid.Column="0"
                           Text="✍️"
                           FontSize="40"
                           VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Test Your Baybayin"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#654321"/>
                        <Label Text="Convert Latin to Baybayin and practice reading"
                               FontSize="14"
                               TextColor="#8B7355"/>
                    </VerticalStackLayout>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTestYourBaybayinClicked"/>
                </Border.GestureRecognizers>
            </Border>

            <!-- Write Button (NEW) -->
            <Border x:Name="WriteBorder"
                    BackgroundColor="#FFF8DC"
                    Stroke="#B22222"
                    StrokeThickness="2"
                    Padding="20"
                    Opacity="0"
                    TranslationX="30"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.2}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                    <Label Grid.Column="0"
                           Text="✏️"
                           FontSize="40"
                           VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Write Baybayin"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#B22222"/>
                        <Label Text="Trace and write characters with speed scoring!"
                               FontSize="14"
                               TextColor="#8B7355"/>
                    </VerticalStackLayout>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnWriteClicked"/>
                </Border.GestureRecognizers>
            </Border>

        </VerticalStackLayout>

        <!-- Footer Tip -->
        <Label Grid.Row="3"
               Text="💡 Tip: Start with Memorize, then take the Quiz!"
               FontSize="12"
               FontAttributes="Italic"
               TextColor="#8B7355"
               HorizontalOptions="Center"
               Margin="0,20,0,0"/>

    </Grid>

</ContentPage>
