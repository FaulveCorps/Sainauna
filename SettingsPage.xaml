<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sainauna.SettingsPage"
             Title="Settings"
             BackgroundColor="#F5EBDC">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

        <!-- Header -->
        <Label Grid.Row="0"
               Text="Settings"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#654321"
               HorizontalOptions="Center"
               Margin="0,10,0,30"/>

        <!-- Settings Content -->
        <VerticalStackLayout Grid.Row="1" Spacing="25">

            <!-- Progress Section -->
            <Border BackgroundColor="#E8DCC8"
                    Stroke="#8B5A2B"
                    StrokeThickness="2"
                    Padding="20"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.2}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Current Progress"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#654321"
                           HorizontalOptions="Center"/>

                    <ProgressBar x:Name="ProgressBar"
                                Progress="0"
                                ProgressColor="#8B5A2B"
                                HeightRequest="20"
                                Margin="0,10,0,5"/>

                    <Label x:Name="ProgressLabel"
                           Text="0%"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#8B5A2B"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Reset Progress Button -->
            <Button Text="Reset Progress"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#FFF8DC"
                    BackgroundColor="#B22222"
                    CornerRadius="15"
                    HeightRequest="60"
                    Clicked="OnResetProgressClicked"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Radius=6, Opacity=0.3}"/>

            <!-- About Section -->
            <Border BackgroundColor="#FFF8DC"
                    Stroke="#8B5A2B"
                    StrokeThickness="2"
                    Padding="20"
                    Margin="0,20,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="About Sainauna"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#654321"
                           HorizontalOptions="Center"/>

                    <Label Text="Sainauna is an educational mobile app that teaches Baybayin in a simple, interactive, and modern way."
                           FontSize="14"
                           TextColor="#8B7355"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="Target: Students, Teachers, Culture Enthusiasts"
                           FontSize="12"
                           TextColor="#A0522D"
                           HorizontalOptions="Center"
                           FontAttributes="Italic"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="#D2B48C"
                             Margin="0,10,0,10"/>

                    <Label Text="Version 2.0 - Vintage Edition"
                           FontSize="12"
                           TextColor="#8B7355"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

        <!-- Footer -->
        <Label Grid.Row="2"
               Text="Preserve our heritage, learn Baybayin"
               FontSize="12"
               FontAttributes="Italic"
               TextColor="#8B7355"
               HorizontalOptions="Center"
               Margin="0,20,0,0"/>

    </Grid>

</ContentPage>
